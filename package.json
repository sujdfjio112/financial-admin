{
  "name": "financial-admin",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "postbuild": "node scripts/copy-index-to-404.js /financial-admin/",
    "preview": "vite preview",
    "lint": "eslint --ext .ts,.tsx,.vue src",
    "format": "prettier --write \"src/**/*.{ts,tsx,vue,js,json,css,scss,md}\"",
    "deploy": "gh-pages -d dist -b gh-pages"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "critical": "^7.2.1",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.5.1",
    "gh-pages": "^6.3.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.2.6",
    "vue-tsc": "^3.1.0"
  }
}
